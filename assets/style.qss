QWidget {
    background-color: #f8fafc;
    color: #0f172a;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}
QLabel { background: transparent; }
QPushButton {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    padding: 7px 12px;
    min-height: 22px;
    font-weight: 600;
}
QPushButton:hover { background-color: #f1f5f9; border-color: #94a3b8; }
QPushButton:pressed { background-color: #e2e8f0; }
QPushButton:focus, QLineEdit:focus, QSpinBox:focus, QTimeEdit:focus {
    border: 2px solid #b45309;
}
QPushButton:disabled { color: #94a3b8; background-color: #f1f5f9; }
#titleLabel { font-size: 19px; font-weight: 700; }
#monthTitle { font-size: 16px; font-weight: 700; }
#iconButton { min-width: 28px; max-width: 28px; padding: 3px; min-height: 26px; }
#navButton { min-width: 25px; max-width: 25px; padding: 5px; }
#todayButton { color: #047857; border-color: #047857; }
#primaryButton { background-color: #b45309; border-color: #b45309; color: #ffffff; min-height: 26px; }
#primaryButton:hover { background-color: #92400e; border-color: #92400e; }
#primaryButton:pressed { background-color: #78350f; }
#primaryButton:focus { border: 2px solid #0f172a; }
#calendarFrame { border: 1px solid #d8e0ea; border-radius: 10px; background-color: #ffffff; }
#weekdayHeader, #sundayHeader { font-size: 13px; font-weight: 600; padding: 3px; }
#sundayHeader { color: #9a3412; }
#dayCell { background-color: #ffffff; border: 2px solid transparent; border-radius: 7px; }
#dayCell:hover { background-color: #f1f5f9; }
#dayCell[today="true"] { border-color: #047857; }
#dayCell[selected="true"] { background-color: #fff7ed; border-color: #b45309; }
#dayCell:focus { border-color: #0f172a; }
#solarDay { font-size: 17px; font-weight: 700; }
#lunarDay { font-size: 12px; color: #475569; }
#dayCell[inMonth="false"] #solarDay, #dayCell[inMonth="false"] #lunarDay { color: #64748b; }
#dayCell[sunday="true"] #solarDay { color: #9a3412; }
#dayCell[today="true"] #solarDay { color: #047857; }
#dayCell[selected="true"] #solarDay { color: #92400e; }
#reminderDot { color: #b45309; font-size: 12px; font-weight: 700; }
#detailCard { background-color: #f1f5f9; border: 1px solid #d8e0ea; border-radius: 9px; }
#detailMain { font-size: 16px; font-weight: 700; }
#secondaryText { color: #475569; font-size: 13px; }
#sectionTitle { font-size: 15px; font-weight: 700; }
#dailyScroll, #dailyContainer, #reminderList { border: none; background: transparent; }
#dailyReminder, #reminderCard { background-color: #ffffff; border: 1px solid #d8e0ea; border-radius: 9px; }
#reminderTitle { font-weight: 700; font-size: 14px; }
#timeBadge { background-color: #ffedd5; color: #9a3412; font-size: 14px; font-weight: 700; padding: 5px 8px; border-radius: 6px; }
#emptyState { color: #475569; padding: 12px; }
#dialogTitle { font-size: 21px; font-weight: 700; }
QLineEdit, QSpinBox, QTimeEdit {
    min-height: 30px; padding: 4px 8px; border: 1px solid #94a3b8;
    border-radius: 7px; background-color: #ffffff; selection-background-color: #b45309;
}
QSpinBox:disabled { background-color: #e2e8f0; color: #64748b; }
QCheckBox { spacing: 8px; padding: 4px 0; }
QCheckBox::indicator { width: 19px; height: 19px; }
QCheckBox:focus { outline: 2px solid #b45309; }
#infoNote { color: #78350f; background-color: #fff7ed; padding: 11px; border-radius: 8px; }
#errorLabel { color: #991b1b; background-color: #fef2f2; padding: 8px; border-radius: 6px; }
#undoBar { background-color: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; }
#textButton { color: #9a3412; background: transparent; border: none; }
QListWidget::item { border: none; }
QListWidget::item:selected { background-color: #ffedd5; }
QMenu { background-color: #ffffff; border: 1px solid #cbd5e1; padding: 5px; }
QMenu::item { padding: 8px 18px; }
QMenu::item:selected { background-color: #ffedd5; color: #78350f; }
QScrollBar:vertical { width: 8px; background: #f1f5f9; }
QScrollBar::handle:vertical { background: #cbd5e1; border-radius: 4px; min-height: 20px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
